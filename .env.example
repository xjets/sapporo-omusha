# Copy to .env.local and load it your own way; the server reads plain environment variables.
# Everything is optional: with nothing set, the pages and the record work and the AI parts say "not set up".
GEMINI_API_KEY=
ELEVENLABS_API_KEY=
# Shared password for the whole site (HTTP Basic, any user name). Leave empty on your own machine.
APP_PASSWORD=
# Needed only to upload media to a deployed site.
UPLOAD_TOKEN=
# Optional S3-compatible bucket for media and gathered records; without it, local folders are used.
BUCKET=
ENDPOINT=
REGION=
ACCESS_KEY_ID=
SECRET_ACCESS_KEY=
PORT=8081
